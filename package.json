{
  "name": "loopbridge",
  "version": "0.3.4",
  "description": "Desktop tool to migrate Confluence pages to Microsoft Loop via clipboard-assisted paste.",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": {
    "name": "hoangsnowy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoangsnowy/loopbridge.git"
  },
  "homepage": "https://github.com/hoangsnowy/loopbridge",
  "bugs": {
    "url": "https://github.com/hoangsnowy/loopbridge/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "pretest": "npm rebuild better-sqlite3 --build-from-source=false",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "npm rebuild better-sqlite3 --build-from-source=false",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "electron-rebuild --module-dir . --force --only better-sqlite3",
    "electron-rebuild": "electron-rebuild --module-dir . --force --only better-sqlite3",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "prescreenshots": "npm run build && electron-rebuild --module-dir . --force --only better-sqlite3",
    "screenshots": "playwright test --config e2e/playwright.screenshots.config.ts",
    "postinstall:electron": "electron-builder install-app-deps",
    "build:unpacked": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win nsis msi",
    "sbom": "cdxgen -o sbom.cdx.json --spec-version 1.5",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "prepare": "husky",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.16",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-virtual": "^3.13.25",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-stringify": "^6.7.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.17.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "sanitize-html": "^2.17.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "turndown": "^7.2.4",
    "undici": "^8.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@commitlint/config-conventional": "^21.0.2",
    "@cyclonedx/cdxgen": "^12.4.3",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.60.0",
    "@release-it/conventional-changelog": "^11.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.5.0",
    "electron": "^41.6.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "husky": "^9.1.6",
    "lint-staged": "^17.0.7",
    "nock": "^14.0.15",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "release-it": "^20.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.0.0",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml}": [
      "prettier --write"
    ]
  }
}
